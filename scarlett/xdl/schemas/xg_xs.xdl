enum XG_SWIZZLE_MODE : uint32_t {
    XG_SWIZZLE_LINEAR = 0,
    XG_SWIZZLE_4KB_D = 1,
    XG_SWIZZLE_4KB_S = 2,
    XG_SWIZZLE_64KB_S = 3,
    XG_SWIZZLE_64KB_D = 4,
    XG_SWIZZLE_64KB_R_X = 5,
    XG_SWIZZLE_64KB_D_X = 6,
    XG_SWIZZLE_64KB_S_X = 7
};

struct XG_SUBRESOURCE_LAYOUT {
    uint64_t SizeBytes;
    uint64_t OffsetBytes;
    uint64_t RowPitchBytes;
    uint64_t DepthPitchBytes;
    uint32_t WidthElements;
    uint32_t HeightElements;
    uint32_t Depth;
    uint32_t TileMode;
};

struct XG_RESOURCE_LAYOUT {
    uint64_t SizeBytes;
    uint64_t BaseAlignmentBytes;
    uint32_t MipLevels;
    uint32_t Planes;
    XG_SWIZZLE_MODE SwizzleMode;
    uint32_t Flags;
};

struct XG_TEXTURE2D_DESC {
    uint32_t Width;
    uint32_t Height;
    uint32_t MipLevels;
    uint32_t ArraySize;
    uint32_t Format;
    uint32_t SampleCount;
    uint32_t SampleQuality;
    uint32_t Usage;
    uint32_t BindFlags;
    uint32_t MiscFlags;
    XG_SWIZZLE_MODE SwizzleMode;
    uint32_t PitchAlignment;
    [added(10.0.22621.1806)] uint32_t SamplerFeedbackMipRegionWidth;
    [added(10.0.22621.1806)] uint32_t SamplerFeedbackMipRegionHeight;
};

